# Кнопка возврата к билету
@router.callback_query(F.data == "back_to_ticket")
async def back_to_ticket(callback: CallbackQuery, state: FSMContext):
  data = await state.get_data()
  name = data.get("name", "Гость")
  guest_type = data.get("guest_type", "zakhar")

  ticket_bytes = generate_ticket(name, guest_type)
  photo = BufferedInputFile(ticket_bytes, filename="ticket.png")

  keyboard = InlineKeyboardMarkup(
      inline_keyboard=[
          [
              InlineKeyboardButton(
